{
  "version": "latest",
  "architecture": {
    "standard": "sliced-dotnet/1"
  },
  "answers": {
    "tests.unit": {
      "paths": [
        "backend/Bugget.UnitTests",
        "frontend/src"
      ]
    },
    "tests.integration": {
      "paths": [
        "backend/Bugget.IntegrationTests"
      ]
    },
    "tests.architecture": {
      "paths": [
        "backend/Bugget.Architecture.Tests",
        "frontend/steiger.config.js"
      ]
    },
    "format": {
      "paths": [
        "backend/.editorconfig",
        "frontend/.prettierrc"
      ]
    },
    "lint": {
      "paths": [
        "backend/Directory.Build.props",
        "frontend/eslint.config.js"
      ]
    },
    "build": {
      "paths": [
        "backend/Bugget.slnx",
        "frontend/vite.config.ts"
      ]
    },
    "typecheck": {
      "paths": [
        "frontend/tsconfig.json"
      ]
    },
    "verify": {
      "paths": [
        "scripts/verify.sh"
      ]
    }
  },
  "applicability": {
    "csharp": {
      "applicable": true
    },
    "yaml": {
      "applicable": true
    },
    "typescript": {
      "applicable": true
    },
    "dotnet": {
      "applicable": true
    }
  },
  "generated": [
    {
      "paths": [
        "backend/Bugget.Api/Generated",
        "backend/Bugget.Contracts/Generated"
      ],
      "reason": "собирается из specs/contracts/**/openapi.yaml скриптом scripts/contracts/openapi-generate.sh, руками не правится — ADR-0005"
    }
  ],
  "settings": {
    "complexity.csharp": {
      "averageReachableFiles": 8.0,
      "largestCyclicGroupSize": 0
    },
    "comments.csharp": {
      "minimumCommentLines": 10,
      "percentageLimit": 8
    },
    "comments.yaml": {
      "minimumCommentLines": 10,
      "percentageLimit": 8
    },
    "comments.typescript": {
      "minimumCommentLines": 10,
      "percentageLimit": 8
    },
    "duplication.csharp": {
      "windowLines": 30,
      "minimumTokens": 90
    },
    "commits": {
      "language": "ru",
      "requireSetup": true
    },
    "complexity.typescript": {
      "averageReachableFiles": 32.2,
      "largestCyclicGroupSize": 0
    },
    "adrs.shape": {
      "wordLimit": 1000,
      "fencedLineLimit": 10,
      "tableRowLimit": 12
    },
    "duplication.typescript": {
      "windowLines": 30,
      "minimumTokens": 90
    },
    "functions.csharp": {
      "ownLines": 80
    },
    "warning-suppressions.dotnet": {
      "repositoryWide": [
        {
          "id": "CA1001",
          "reason": "SemaphoreSlim без AvailableWaitHandle не держит неуправляемых ресурсов, а таймер ReloadableMemoryCache освобождается в StopAsync"
        },
        {
          "id": "CA1707",
          "reason": "имена тестов — snake_case по идиоме xUnit; правило одно на репозиторий без посекционных послаблений"
        },
        {
          "id": "CA1711",
          "reason": "суффиксы Collection/Queue/EventHandler: xUnit-коллекции и TaskQueue названы по смыслу: в этом коде шум latest-Recommended, а не дефект"
        },
        {
          "id": "CA1716",
          "reason": "конфликт имён с ключевыми словами VB проект не касается"
        },
        {
          "id": "CA1720",
          "reason": "ReportAliasMode.Guid — буквальное значение режима \"guid\": в этом коде шум latest-Recommended, а не дефект"
        },
        {
          "id": "CA1848",
          "reason": "LoggerMessage-делегаты: в этом коде шум latest-Recommended, а не дефект"
        },
        {
          "id": "CA1861",
          "reason": "все срабатывания — литеральные массивы в тестовых assert'ах, выполняемые один раз; автофикс правила падает"
        },
        {
          "id": "CS1591",
          "reason": "XML-документацию Bugget.Api читает Swagger ради сгенерированных из OpenAPI контроллеров (ADR-0005), в Domain и Contracts она держит проверку cref; рукописному публичному API она не обязательна"
        }
      ]
    }
  },
  "policy": {
    "harness.config": "required",
    "harness.coverage": "required",
    "architecture.sliced-dotnet.zone-shape": "off",
    "architecture.sliced-dotnet.slice-shape": "off",
    "architecture.sliced-dotnet.segment-names": "off",
    "architecture.sliced-dotnet.layer-assemblies": "off",
    "architecture.sliced-dotnet.dependency-direction": "off",
    "architecture.sliced-dotnet.slice-isolation": "off",
    "architecture.sliced-dotnet.public-api": "off",
    "architecture.sliced-dotnet.cross-api": "off",
    "complexity.csharp": "required",
    "docs.policy": "required",
    "commits.setup": "required",
    "comments.csharp": "required",
    "comments.yaml": "required",
    "comments.typescript": "required",
    "types-per-file.csharp": "required",
    "dependencies.csharp": "required",
    "duplication.csharp": "required",
    "build-properties.dotnet": "required",
    "central-packages.dotnet": "required",
    "solution-format.dotnet": "required",
    "editorconfig.dotnet": "required",
    "warning-suppressions.dotnet": "required",
    "frame.tests.unit": "required",
    "frame.tests.integration": "required",
    "frame.tests.architecture": "required",
    "frame.format": "required",
    "frame.lint": "required",
    "frame.build": "required",
    "frame.typecheck": "required",
    "frame.verify": "required",
    "complexity.typescript": "required",
    "adrs.shape": "required",
    "dependencies.typescript": "required",
    "duplication.typescript": "required",
    "functions.csharp": "required"
  }
}
