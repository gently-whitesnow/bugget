<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Модуль объединённого bugget-api: своего хоста нет, точка входа — проект Bugget. -->
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OidcAuth\OidcAuth.csproj" />
    <ProjectReference Include="..\FakeAuth\FakeAuth.csproj" />
    <ProjectReference Include="..\Authorization.Abstractions\Authorization.Abstractions.csproj" />
    <ProjectReference Include="..\Authentication\Authentication.csproj" />
    <ProjectReference Include="..\Bugget.Http\Bugget.Http.csproj" />
    <!-- Словарь ошибок модуля users: IUsersClient — порт authorization в users,
         и ошибка через него приходит именно оттуда (ADR-0004). -->
    <ProjectReference Include="..\Users.Entities\Users.Entities.csproj" />
    <ProjectReference Include="..\Caching.Local\Caching.Local.csproj" />
    <ProjectReference Include="..\BugReport.Logging\BugReport.Logging.csproj" />
  </ItemGroup>

</Project>
