<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 (нет XML-комментария у public-члена) выключен: XML-документация
             включена ради сгенерированных из OpenAPI типов, которым комментарии пишет
             генератор, а не человек (ADR-0005). Послабление приехало из проектов,
             слитых в квартет в MAIN-20, и в снимке .quality/backend-suppress-baseline.json
             сокращается. -->
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <!--
      Провод наружу и ничего кроме: сгенерированное из specs/contracts/**/openapi.yaml
      (ADR-0005) плюс partial-объявления строгости из StrictContracts.cs. Лист графа —
      ни проектов решения, ни пакетов. Команды и результаты прикладного слоя живут в
      Bugget.Application и превращаются в эти типы мапперами на границе Bugget.Api.
    -->

</Project>
