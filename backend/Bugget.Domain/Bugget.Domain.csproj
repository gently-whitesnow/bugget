<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 (нет XML-комментария у public-члена) выключен: XML-документация
             включена ради сгенерированных из OpenAPI типов и контроллеров, которым
             комментарии пишет генератор, а не человек (ADR-0005). Послабление приехало
             из проектов, слитых в квартет в MAIN-20, и в снимке .quality/backend-suppress-baseline.json
             сокращается: было десять записей, стало три. -->
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <!-- Доменный слой — лист графа: ни проектов, ни пакетов, только BCL (ADR-0001). -->

</Project>
