{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "app": "bugget-api"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:7777"
      }
    }
  },

  "//": "--- модуль reports ---",
  "FileStorageOptions": {
    "BaseDirectory": "/file-storage"
  },
  "OptimizatorSettings": {
    "FfmpegDirectory": "/ffmpeg"
  },
  "ReportAliasOptions": {
    "AliasMode": "default"
  },

  "//authentication": "Заголовки от nginx auth_request. Реальные имена приходят из external_settings.json",
  "ExternalSettings": {
    "Authentication": {
      "UserIdHeaderName": null,
      "TeamIdHeaderName": null,
      "OrganizationIdHeaderName": null,
      "WorkspaceIdHeaderName": null,
      "WorkspaceRoleHeaderName": null
    }
  },

  "//users": "--- модуль users ---",
  "SelfHostedOptions": {
    "Enabled": true,
    "DefaultWorkspaceName": "workspace"
  },
  "TeamsOptions": {
    "DefaultSizeLimit": 20,
    "DefaultTeamsCountLimit": 5
  },
  "WorkspacesOptions": {
    "DefaultSizeLimit": 100
  },
  "UsersFileStorageOptions": {
    "BaseDirectory": "/users-file-storage"
  },
  "MattermostOAuthOptions": {
    "Enabled": false,
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "SuccessRedirectPath": "/settings"
  },
  "MattermostBotOptions": {
    "Enabled": false,
    "BaseUrl": "",
    "BotAccessToken": ""
  },

  "//authorization": "--- модуль authorization ---",
  "KeyStoreOptions": {
    "PemFilePath": "/keys/rsa_pairs.json"
  },
  "JwtOptions": {
    "Issuer": "bugget",
    "Audience": "bugget",
    "AccessLifetime": "00:15:00",
    "RefreshLifetime": "30.00:00:00"
  },
  "UserCacheOptions": {
    "ExpirationTime": "00:15:00"
  },
  "OidcAuthOptions": {
    "Enabled": false
  },
  "TelegramLoggingOptions": {
    "Enabled": false
  }
}
