<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Compile-time guards: новые варнинги блокируют build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>

  </PropertyGroup>

  <!--
    Модули, приехавшие из bugreport (users-api, authorization-api, общие библиотеки),
    писались без warnings-as-errors. Пока их предупреждения не разобраны, строгий режим
    для них выключен — иначе объединённое решение не собирается. Снимать послабление
    по мере чистки, проект за проектом.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Users.'))
                         Or $(MSBuildProjectName.StartsWith('Authorization.'))
                         Or '$(MSBuildProjectName)' == 'Authentication'
                         Or '$(MSBuildProjectName)' == 'Caching.Local'
                         Or '$(MSBuildProjectName)' == 'BugReport.Logging'
                         Or '$(MSBuildProjectName)' == 'FakeAuth'
                         Or '$(MSBuildProjectName)' == 'OidcAuth'
                         Or '$(MSBuildProjectName)' == 'MattermostOAuth'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
