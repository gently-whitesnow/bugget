<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Модуль объединённого bugget-api: своего хоста нет, точка входа — проект Bugget. -->
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Мапперы в контрактные DTO internal: снаружи модуля они не нужны, а его
         собственным тестам — да. -->
    <InternalsVisibleTo Include="Users.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Users.BO\Users.BO.csproj" />
    <ProjectReference Include="..\Users.DA\Users.DA.csproj" />
    <ProjectReference Include="..\Users.DbUp\Users.DbUp.csproj" />
    <ProjectReference Include="..\BugReport.Logging\BugReport.Logging.csproj" />
    <ProjectReference Include="..\MattermostOAuth\MattermostOAuth.csproj" />
    <ProjectReference Include="..\Bugget.Http\Bugget.Http.csproj" />
  </ItemGroup>

</Project>
