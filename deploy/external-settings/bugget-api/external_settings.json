{
    "ExternalSettings": {
        "Authentication": {
            "UserIdHeaderName": "Auth-Request-User-Id",
            "TeamIdHeaderName": "Auth-Request-Team-Id",
            "OrganizationIdHeaderName": "Auth-Request-Workspace-Id",
            "WorkspaceIdHeaderName": "Auth-Request-Workspace-Id",
            "WorkspaceRoleHeaderName": "Auth-Request-Workspace-Role",
            "AuthMethodHeaderName": "Auth-Request-Auth-Method"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName"
        ],
        "Properties": {
            "app": "bugget-api"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "restrictedToMinimumLevel": "Information"
                }
            }
        ]
    }
}
