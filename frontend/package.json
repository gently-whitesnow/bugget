{
  "name": "bugget",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run start-backend && npm run dev",
    "start-backend": "APP_DOMAIN=http://localhost:5173 docker compose -f ../deploy/docker-compose.dev.yml up -d --build",
    "stop-backend": "docker compose -f ../deploy/docker-compose.dev.yml down -v",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx,json,css}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@tailwindcss/typography": "^0.5.16",
    "axios": "^1.13.6",
    "daisyui": "^5.0.9",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "effector": "^23.3.0",
    "effector-react": "^23.3.0",
    "lucide-react": "^0.483.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.2",
    "throttle-debounce": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@feature-sliced/steiger-plugin": "^0.5.8",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.16",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/throttle-debounce": "^5.0.2",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.19.0",
    "eslint-plugin-effector": "^0.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.3",
    "steiger": "^0.5.9",
    "tailwindcss": "^4.0.16",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
